    { "name": "Агент", "short_name": "Агент", "url": "./index.html?go=agent", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Контакты", "short_name": "Позвонить", "url": "./index.html?go=contacts", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "file", "accept": [".orbit", ".json", "application/json", "text/plain"] }] }
  },
  "file_handlers": [{ "action": "./index.html", "accept": { "application/json": [".orbit", ".json"] } }]
